#!/bin/bash
# ─── Oracle Loop Configuration ──────────────────────────────────
# Stack: {{ .StackName }} ({{ .FrameworkVersion }})
# Generated by oracle-cli on {{ .CreatedDate }}
# ────────────────────────────────────────────────────────────────

# ─── Stack Identity ─────────────────────────────────────────────
STACK_NAME="{{ .StackName }}"

# ─── Cycle Limits ──────────────────────────────────────────────
RESEARCH_CYCLES=4           # Fixed: one cycle per topic group
RESEARCHER_MAX_TURNS=20     # Search + fetch + clone + write research docs
REVIEWER_MAX_TURNS=8        # Read research + write APPROVED/REQUEST_MORE
SYNTHESIZER_MAX_TURNS=60    # Read all research + write 19 knowledge docs

# ─── Model ─────────────────────────────────────────────────────
MODEL="claude-sonnet-4-6"

# ─── Paths ─────────────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TASKS_DIR="${PROJECT_DIR}/tasks"
RESEARCH_DIR="${TASKS_DIR}/research"
REVIEW_DIR="${TASKS_DIR}/review"
CYCLES_DIR="${TASKS_DIR}/cycles"
PROMPTS_DIR="${PROJECT_DIR}/.autonomous/prompts"
OUTPUT_DIR="${PROJECT_DIR}/output"

# ─── Topic Groups (for reference — researcher reads from prompt) ─
# Cycle 1 (Foundations):    00-core-principles, 01-project-structure, 02-layered-architecture, 03-dependency-injection
# Cycle 2 (Implementation): 04-error-handling, 05-testing, 06-database, 07-configuration
# Cycle 3 (API & Ops):      08-api-design, 09-security, 10-deployment, 11-redis-caching
# Cycle 4 (Advanced):       12-queue-integration, 13-observability, 15-api-documentation, 16-documentation-standards, 99-completion-protocol

# ─── Gold Standards ───────────────────────────────────────────
{{ if .GoldStandardsDir -}}
GOLD_STANDARDS_DIR="{{ .GoldStandardsDir }}"
{{- else -}}
GOLD_STANDARDS_DIR=""  # No gold standards — synthesizer relies on research quality
{{- end }}

# ─── Tool Allowlists ──────────────────────────────────────────
BASE_TOOLS="Read,Write,Edit,Glob,Grep,Agent,ToolSearch"

# Researcher: information gathering — web + git + write
RESEARCHER_TOOLS="${BASE_TOOLS},WebSearch,WebFetch,Bash(git clone *),Bash(git *),Bash(ls *),Bash(cat *),Bash(find *),Bash(mkdir *)"

# Reviewer: read-only — validates research quality
REVIEWER_TOOLS="Read,Glob,Grep,Write"

# Synthesizer: read research + write knowledge docs
SYNTHESIZER_TOOLS="${BASE_TOOLS},Bash(ls *),Bash(mkdir *)"

# ─── Update Configuration (used by update.sh only) ──────────
UPDATE_RESEARCH_CYCLES=2
