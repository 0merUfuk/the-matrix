tools: Read, Grep, Glob, Bash(make build), Bash(go vet ./...), Bash(git diff *), Bash(git log *), Bash(ls *), Bash(go list -m all), mcp__MCP_DOCKER__sequentialthinking, mcp__plugin_github_github__search_code
