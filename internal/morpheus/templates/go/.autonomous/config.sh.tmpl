#!/bin/bash
# ─── Autonomous Loop Configuration ─────────────────────────────
# Go microservice: {{ .ServiceName }}
# Generated by morp-cli on {{ .CreatedDate }}
# ────────────────────────────────────────────────────────────────

# ─── Cycle Limits ──────────────────────────────────────────────
MAX_CYCLES={{ .MaxCycles }}
MANAGER_MAX_TURNS=15                            # Planning-only: review cycles, reprioritize tasks
STRATEGIST_MAX_TURNS=20                         # Research: architectural analysis, web search
DEVELOPER_MAX_TURNS={{ .DeveloperMaxTurns }}    # Go needs: read → code → go mod tidy → make build → lint → wire → commit
TESTER_MAX_TURNS={{ .TesterMaxTurns }}          # Ginkgo suites: read → write tests → mockgen → make test → fix → commit
REVIEWER_MAX_TURNS={{ .ReviewerMaxTurns }}      # Read-only review + write findings
SECURITY_MAX_TURNS=40                           # Security audit: vulnerability analysis, read-only

# ─── Model ─────────────────────────────────────────────────────
MODEL="claude-sonnet-4-6"

# ─── Paths ─────────────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TASKS_DIR="${PROJECT_DIR}/tasks"
CYCLES_DIR="${TASKS_DIR}/cycles"
PROMPTS_DIR="${PROJECT_DIR}/.autonomous/prompts"

# ─── Tool Allowlists ──────────────────────────────────────────
# NOTE: Shell redirections (2>&1, |, >) are NOT part of the command
# string for tool matching — they caused silent denials in testing.
# Solution: use broad prefixes like Bash(go *), Bash(make *).

BASE_TOOLS="Read,Write,Edit,Glob,Grep,Agent,ToolSearch,WebFetch,WebSearch"

# Developer: broad Go/make/git access
DEVELOPER_TOOLS="${BASE_TOOLS},Bash(go *),Bash(make *),Bash(wire *),Bash(golangci-lint *),Bash(mockgen *),Bash(goose *),Bash(ginkgo *),Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff *),Bash(git log *),Bash(git tag *),Bash(git show-ref *),Bash(ls *),Bash(mkdir *),Bash(cat *),Bash(chmod *)"

# Tester: same Go tools + git (needs to fix code and write tests)
TESTER_TOOLS="${BASE_TOOLS},Bash(go *),Bash(make *),Bash(wire *),Bash(golangci-lint *),Bash(mockgen *),Bash(ginkgo *),Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff *),Bash(git log *),Bash(git tag *),Bash(ls *)"

# Reviewer: read-only — no git commits, no go install
# Write (not Edit) so reviewer can create cycle reports and rewrite tasks/ files
# without being able to modify source code via Edit's targeted replacements.
# Note: git tag + git show-ref allows reviewer to scope diffs by cycle tag
REVIEWER_TOOLS="Read,Write,Glob,Grep,Agent,ToolSearch,Bash(make build),Bash(make test),Bash(make lint),Bash(go vet *),Bash(go build *),Bash(git log *),Bash(git diff *),Bash(git show *),Bash(git status),Bash(git tag *),Bash(git show-ref *),Bash(ls *)"

# Manager: planning-only — reviews cycles, reprioritizes tasks, no code commits
MANAGER_TOOLS="Read,Glob,Grep,Agent,ToolSearch,Bash(git log *),Bash(git diff *),Bash(git show *),Bash(git status),Bash(ls *)"

# Strategist: research-oriented — web search, architectural analysis, no code commits
STRATEGIST_TOOLS="Read,Glob,Grep,Agent,ToolSearch,WebSearch,WebFetch,Bash(git log *),Bash(git diff *),Bash(git status),Bash(ls *)"

# Security: read-only audit — vulnerability analysis with sequentialthinking, no code commits
SECURITY_TOOLS="Read,Write,Glob,Grep,Agent,ToolSearch,mcp__sequentialthinking__sequentialthinking,Bash(make build),Bash(go vet *),Bash(go list *),Bash(git log *),Bash(git diff *),Bash(git status),Bash(ls *)"
