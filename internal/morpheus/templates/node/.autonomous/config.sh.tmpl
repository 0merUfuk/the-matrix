#!/bin/bash
# ─── Autonomous Loop Configuration ─────────────────────────────
# Node.js microservice: {{ .ServiceName }}
# Generated by morp-cli on {{ .CreatedDate }}
# ────────────────────────────────────────────────────────────────

# ─── Cycle Limits ──────────────────────────────────────────────
MAX_CYCLES={{ .MaxCycles }}
MANAGER_MAX_TURNS=15                            # Planning-only: review cycles, reprioritize tasks
STRATEGIST_MAX_TURNS=20                         # Research: architectural analysis, web search
DEVELOPER_MAX_TURNS={{ .DeveloperMaxTurns }}    # Node: read → code → npm install → npm test → commit
TESTER_MAX_TURNS={{ .TesterMaxTurns }}          # Jest tests: read → write → run → fix → commit
REVIEWER_MAX_TURNS={{ .ReviewerMaxTurns }}      # Read-only review + write findings
SECURITY_MAX_TURNS=40                           # Security audit: vulnerability analysis, read-only

# ─── Model ─────────────────────────────────────────────────────
MODEL="claude-sonnet-4-6"

# ─── Paths ─────────────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TASKS_DIR="${PROJECT_DIR}/tasks"
CYCLES_DIR="${TASKS_DIR}/cycles"
PROMPTS_DIR="${PROJECT_DIR}/.autonomous/prompts"

# ─── Tool Allowlists ──────────────────────────────────────────
BASE_TOOLS="Read,Write,Edit,Glob,Grep,Agent,ToolSearch,WebFetch,WebSearch"

# Developer: Node.js + npm + git
DEVELOPER_TOOLS="${BASE_TOOLS},Bash(npm *),Bash(node *),Bash(npx *),Bash(prisma *),Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff *),Bash(git log *),Bash(git tag *),Bash(ls *),Bash(mkdir *),Bash(cat *),Bash(chmod *)"

# Tester: same tools
TESTER_TOOLS="${BASE_TOOLS},Bash(npm *),Bash(node *),Bash(npx *),Bash(jest *),Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff *),Bash(git log *),Bash(git tag *),Bash(ls *)"

# Reviewer: read-only
# Write (not Edit) so reviewer can create cycle reports and rewrite tasks/ files
# without being able to modify source code via Edit's targeted replacements.
REVIEWER_TOOLS="Read,Write,Glob,Grep,Agent,ToolSearch,Bash(npm test),Bash(npm run lint),Bash(npm run build),Bash(git log *),Bash(git diff *),Bash(git show *),Bash(git status),Bash(git tag *),Bash(git show-ref *),Bash(ls *)"

# Manager: planning-only — reviews cycles, reprioritizes tasks, no code commits
MANAGER_TOOLS="Read,Glob,Grep,Agent,ToolSearch,Bash(git log *),Bash(git diff *),Bash(git show *),Bash(git status),Bash(ls *)"

# Strategist: research-oriented — web search, architectural analysis, no code commits
STRATEGIST_TOOLS="Read,Glob,Grep,Agent,ToolSearch,WebSearch,WebFetch,Bash(git log *),Bash(git diff *),Bash(git status),Bash(ls *)"

# Security: read-only audit — vulnerability analysis with sequentialthinking, no code commits
SECURITY_TOOLS="Read,Write,Glob,Grep,Agent,ToolSearch,mcp__sequentialthinking__sequentialthinking,Bash(npm run build),Bash(npm audit),Bash(npm test),Bash(npx *),Bash(git log *),Bash(git diff *),Bash(git status),Bash(ls *)"
