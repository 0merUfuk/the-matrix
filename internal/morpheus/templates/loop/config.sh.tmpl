#!/bin/bash
# ─── Autonomous Loop Configuration ─────────────────────────────
# Project: {{ .ProjectName }}
# Generated by morpheus loop on {{ .CreatedDate }}
# ────────────────────────────────────────────────────────────────

# ─── Cycle Limits ──────────────────────────────────────────────
MAX_CYCLES={{ .MaxCycles }}
MANAGER_MAX_TURNS=15
STRATEGIST_MAX_TURNS=20
DEVELOPER_MAX_TURNS={{ .DeveloperMaxTurns }}
TESTER_MAX_TURNS={{ .TesterMaxTurns }}
REVIEWER_MAX_TURNS={{ .ReviewerMaxTurns }}
SECURITY_MAX_TURNS=40

# ─── Model ─────────────────────────────────────────────────────
MODEL="claude-sonnet-4-6"

# ─── Paths ─────────────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TASKS_DIR="${PROJECT_DIR}/tasks"
CYCLES_DIR="${TASKS_DIR}/cycles"
PROMPTS_DIR="${PROJECT_DIR}/.autonomous/prompts"

# ─── Tool Allowlists ──────────────────────────────────────────
# Generic allowlists — not tech-specific.
# The project's CLAUDE.md tells agents which tools and commands to use.

BASE_TOOLS="Read,Write,Edit,Glob,Grep,Agent,ToolSearch,WebFetch,WebSearch"

# Developer: broad access for building and committing
DEVELOPER_TOOLS="${BASE_TOOLS},Bash(make *),Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff *),Bash(git log *),Bash(git tag *),Bash(git show-ref *),Bash(ls *),Bash(mkdir *),Bash(cat *),Bash(chmod *),Bash(go *),Bash(npm *),Bash(npx *),Bash(yarn *),Bash(pnpm *),Bash(cargo *),Bash(python *),Bash(pip *),Bash(flutter *),Bash(dart *),Bash(wire *),Bash(golangci-lint *),Bash(mockgen *),Bash(ginkgo *)"

# Tester: same broad access (needs to fix code and write tests)
TESTER_TOOLS="${BASE_TOOLS},Bash(make *),Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff *),Bash(git log *),Bash(git tag *),Bash(ls *),Bash(go *),Bash(npm *),Bash(npx *),Bash(yarn *),Bash(pnpm *),Bash(cargo *),Bash(python *),Bash(pip *),Bash(flutter *),Bash(dart *),Bash(wire *),Bash(golangci-lint *),Bash(mockgen *),Bash(ginkgo *)"

# Reviewer: read-only — no git commits, limited execution
# Write (not Edit) so reviewer can create cycle reports and rewrite tasks/ files
# without being able to modify source code via Edit's targeted replacements.
REVIEWER_TOOLS="Read,Write,Glob,Grep,Agent,ToolSearch,Bash(make build),Bash(make test),Bash(make lint),Bash(make check),Bash(go vet *),Bash(go build *),Bash(npm test),Bash(npm run lint),Bash(npm run build),Bash(cargo build *),Bash(cargo test *),Bash(git log *),Bash(git diff *),Bash(git show *),Bash(git status),Bash(git tag *),Bash(git show-ref *),Bash(ls *)"

# Manager: planning-only — reviews cycles, reprioritizes tasks, no code commits
MANAGER_TOOLS="Read,Glob,Grep,Agent,ToolSearch,Bash(git log *),Bash(git diff *),Bash(git show *),Bash(git status),Bash(ls *)"

# Strategist: research-oriented — web search, architectural analysis, no code commits
STRATEGIST_TOOLS="Read,Glob,Grep,Agent,ToolSearch,WebSearch,WebFetch,Bash(git log *),Bash(git diff *),Bash(git status),Bash(ls *)"

# Security: read-only audit — vulnerability analysis with sequentialthinking, no code commits
SECURITY_TOOLS="Read,Write,Glob,Grep,Agent,ToolSearch,mcp__sequentialthinking__sequentialthinking,Bash(make build),Bash(go vet *),Bash(go list *),Bash(npm run build),Bash(npm audit),Bash(npm test),Bash(npx *),Bash(git log *),Bash(git diff *),Bash(git status),Bash(ls *)"
