#!/bin/bash
set -euo pipefail

# ─── Finalizer — Post-Loop Context Population ─────────────────────
# Runs after reviewer APPROVED verdict to update runtime context.
# Usage: .autonomous/finalizer.sh  (or via `morp finalize`)
# ──────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

log() {
  echo "$1"
}

source "${SCRIPT_DIR}/config.sh"

CYCLES_DIR="${PROJECT_DIR}/tasks/cycles"
FINALIZER_PROMPT="${SCRIPT_DIR}/prompts/finalizer.md"

# Check completion status — reviewer must have approved
if ! ls "${CYCLES_DIR}"/cycle-*-review.md &>/dev/null || \
   ! grep -q "^## Verdict:.*APPROVED" "${CYCLES_DIR}"/cycle-*-review.md 2>/dev/null; then
  echo "ERROR: Loop has not completed. No reviewer APPROVED verdict found in tasks/cycles/."
  exit 1
fi

# Check security approval — same cycle must have SECURITY_APPROVED
if ! ls "${CYCLES_DIR}"/cycle-*-security.md &>/dev/null || \
   ! grep -q "^## Verdict:.*SECURITY_APPROVED" "${CYCLES_DIR}"/cycle-*-security.md 2>/dev/null; then
  echo "ERROR: No security SECURITY_APPROVED verdict found. The latest cycle requires both reviewer and security approval."
  exit 1
fi

if [ ! -f "${FINALIZER_PROMPT}" ]; then
  echo "ERROR: .autonomous/prompts/finalizer.md not found."
  exit 1
fi

echo "Running finalizer agent for {{ .ServiceName }}..."
echo ""

cd "${PROJECT_DIR}"

check_auth
run_finalizer \
  "$(cat "${FINALIZER_PROMPT}")" \
  "Read,Write,Edit,Glob,Grep,Bash(make build),Bash(make test),Bash(ls *),Bash(cat *),Bash(git log *),Bash(git diff *),Bash(git show *)" \
  15

echo ""
if [ -n "${CONTEXT_DIR:-}" ]; then
  echo "Finalizer complete. Review ${CONTEXT_DIR}/ for updated context files."
else
  echo "Finalizer complete. Review ${CONTEXT_FILE} for updated context."
fi
