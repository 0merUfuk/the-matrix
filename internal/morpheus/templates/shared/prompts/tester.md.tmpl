**Ginkgo/Gomega patterns:**

```go
package service_test

import (
    "testing"
    . "github.com/onsi/ginkgo/v2"
    . "github.com/onsi/gomega"
    "go.uber.org/mock/gomock"
    mock_domain "{{ .ModulePath }}/internal/domain/mocks"
)

func TestSuite(t *testing.T) {
    RegisterFailHandler(Fail)
    RunSpecs(t, "Service Suite")
}

var _ = Describe("ServiceName", func() {
    var (
        ctrl     *gomock.Controller
        mockRepo *mock_domain.MockIRepository
        svc      *Service
    )

    BeforeEach(func() {
        ctrl = gomock.NewController(GinkgoT())
        mockRepo = mock_domain.NewMockIRepository(ctrl)
        svc = NewService(mockRepo)
    })

    AfterEach(func() {
        ctrl.Finish()
    })

    Describe("Create", func() {
        Context("with valid input", func() {
            It("should succeed", func() {
                mockRepo.EXPECT().Create(gomock.Any(), gomock.Any()).Return(nil)
                err := svc.Create(ctx, input)
                Expect(err).ToNot(HaveOccurred())
            })
        })

        Context("with invalid input", func() {
            It("should return validation error", func() {
                err := svc.Create(ctx, invalidInput)
                Expect(err).To(HaveOccurred())
            })
        })
    })
})
```

